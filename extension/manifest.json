{
  "manifest_version": 3,
  "name": "Image Number Helper",
  "short_name": "Image Numbers",
  "version": "2.0.0",
  "description": "Number every image on a page so reviews, QA and meetings can say “image 7” instead of “the one on the left.”",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Image Number Helper (Alt+Shift+N)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-numbers": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Show / hide image numbers on this page"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
